@page
@using SailClubLibrary.Models
@model RazorBoatApp2026.Pages.Members.IndexModel
@{
    ViewData["Title"] = "Member list";
}

<div class="text-center">
    <h1 class="display-3">List of members</h1>
    <h2 class="display-5">There are @Model.Members.Count() members shown</h2>
</div>

<div>
    <button class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-page="/Members/CreateMember">Create</a>
    </button>
</div>

<div class="mt-3">
    <form>
        search: <input type="text" asp-for="FilterCriteria" />
        <select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
            <option value="">All</option>
            <option value="Id">ID</option>
            <option value="FirstName">First name</option>
            <option value="SurName">Surname</option>
            <option value="Address">Address</option>
            <option value="PhoneNumber">Phone number</option>
            <option value="Mail">Mail</option>
            <option value="City">City</option>
        </select>
        <br />
        <!--All-->
        <input type="radio"
            asp-for="SelectedMemberType"
            value=""
            checked="@(Model.SelectedMemberType == null)" />
            <label>All</label>
        <br />
        <!--Enums-->
        @foreach(var type in Enum.GetValues<MemberType>())
        {
            <input type="radio"
                asp-for="SelectedMemberType"
                value="@type" />
            <label>@type</label>

            <br />
        }
        <input type="submit" value="Filter" />
    </form>
</div>

<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>
                <a asp-page="./Index"
                 asp-route-SelectedMemberType="@Model.SelectedMemberType"
                 asp-route-FilterBy="@Model.FilterBy"
                 asp-route-SortColumn="MemberId"
                 asp-route-SortOrder="@Model.Toggle("MemberId")" 
                 asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                 Id @(Model.SortColumn == "MemberId" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
               </a>
            </th>
            <th>
                <a asp-page="./Index"
                   asp-route-SelectedMemberType="@Model.SelectedMemberType"
                   asp-route-FilterBy="@Model.FilterBy"
                   asp-route-SortColumn="FirstName"
                   asp-route-SortOrder="@Model.Toggle("FirstName")"
                   asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                    First name @(Model.SortColumn == "FirstName" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-page="./Index"
                   asp-route-SelectedMemberType="@Model.SelectedMemberType"
                   asp-route-FilterBy="@Model.FilterBy"
                   asp-route-SortColumn="SurName"
                   asp-route-SortOrder="@Model.Toggle("SurName")"
                   asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                    Surname @(Model.SortColumn == "SurName" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-page="./Index"
                   asp-route-SelectedMemberType="@Model.SelectedMemberType"
                   asp-route-FilterBy="@Model.FilterBy"
                   asp-route-SortColumn="PhoneNumber"
                   asp-route-SortOrder="@Model.Toggle("PhoneNumber")"
                   asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                   Phone number @(Model.SortColumn == "PhoneNumber" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-page="./Index"
                   asp-route-SelectedMemberType="@Model.SelectedMemberType"
                   asp-route-FilterBy="@Model.FilterBy"
                   asp-route-SortColumn="MemberAddress"
                   asp-route-SortOrder="@Model.Toggle("MemberAddress")"
                   asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                   Address @(Model.SortColumn == "MemberAddress" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-page="./Index"
                   asp-route-SelectedMemberType="@Model.SelectedMemberType"
                   asp-route-FilterBy="@Model.FilterBy"
                   asp-route-SortColumn="City"
                   asp-route-SortOrder="@Model.Toggle("City")"
                   asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                   City @(Model.SortColumn == "City" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-page="./Index"
                   asp-route-SelectedMemberType="@Model.SelectedMemberType"
                   asp-route-FilterBy="@Model.FilterBy"
                   asp-route-SortColumn="Mail"
                   asp-route-SortOrder="@Model.Toggle("Mail")"
                   asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                   Mail @(Model.SortColumn == "Mail" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-page="./Index"
                   asp-route-SelectedMemberType="@Model.SelectedMemberType"
                   asp-route-FilterBy="@Model.FilterBy"
                   asp-route-SortColumn="MemberType"
                   asp-route-SortOrder="@Model.Toggle("MemberType")"
                   asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                   Member type @(Model.SortColumn == "MemberType" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-page="./Index"
                   asp-route-SelectedMemberType="@Model.SelectedMemberType"
                   asp-route-FilterBy="@Model.FilterBy"
                   asp-route-SortColumn="MemberRole"
                   asp-route-SortOrder="@Model.Toggle("MemberRole")"
                   asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                    Member role @(Model.SortColumn == "MemberRole" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (Member m in Model.Members)
        {
            <tr>
                <td>
                    <img src="~/images/MemberImages/@m.MemberImage" class="img-thumbnail" width="60" height="60"/>
                </td>
                <td>@m.Id</td>
                <td>@m.FirstName</td>
                <td>@m.SurName</td>
                <td>@m.PhoneNumber</td>
                <td>@m.Address</td>
                <td>@m.City</td>
                <td>@m.Mail</td>
                <td>@m.TheMemberType</td>
                <td>@m.TheMemberRole</td>
                <td><a asp-page="EditMember" asp-route-Id="@m.Id" class="btn btn-primary">Edit</a></td>
            </tr>
        }
    </tbody>
</table>
