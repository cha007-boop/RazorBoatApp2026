@page
@using SailClubLibrary.Models
@model RazorBoatApp2026.Pages.Boats.IndexModel
@{
    ViewData["Title"] = "List boats";
}
<div class="text-center">
    <h1 class="display-3">List of boats</h1>
    <h2 class="display-5">There are @Model.Boats.Count() boats in the system</h2>
</div>

<div>
    <button class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-page="/Boats/CreateBoat">Create</a>
    </button>
</div>

<div class="mt-3">
    <form>
        search: <input type="text" asp-for="FilterCriteria" />
        <select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
            <option value="">All</option>
            <option value="Id">ID</option>
            <option value="Model">Model</option>
            <option value="SailNumber">Sail number</option>
            <option value="EngineInfo">Engine info</option>
            <option value="Draft">Draft</option>
            <option value="Widt">Width</option>
            <option value="Length">Length</option>
            <option value="YearOfConstruction">Year of construction</option>
        </select>
        <br />
        <!--All-->
        <input type="radio"
               asp-for="SelectedBoatType"
               value=""
               checked="@(Model.SelectedBoatType == null)" />
        <label>All</label>
        <br />
        <!--Enums-->
        @foreach (var type in Enum.GetValues<BoatType>())
        {
            <input type="radio"
                   asp-for="SelectedBoatType"
                   value="@type" />
            <label>@type</label>

            <br />
        }
        <input type="submit" value="Filter" />
    </form>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-page="Index"
                   asp-route-SortColumn="Id"
                   asp-route-SortOrder="@Model.Toggle("Id")"
                   asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                    ID @(Model.SortColumn == "Id" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-page="Index"
                   asp-route-SortColumn="TheBoatType"
                   asp-route-SortOrder="@Model.Toggle("TheBoatType")"
                   asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                    Boat type @(Model.SortColumn == "TheBoatType" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-page="Index"
                   asp-route-SortColumn="Model"
                   asp-route-SortOrder="@Model.Toggle("Model")"
                   asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                    Model @(Model.SortColumn == "Model" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>
                <a asp-page="Index"
                   asp-route-SortColumn="SailNumber"
                   asp-route-SortOrder="@Model.Toggle("SailNumber")"
                   asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                    Sail number @(Model.SortColumn == "SailNumber" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>Engine info</th>
            <th>Draft</th>
            <th>Width</th>
            <th>Length</th>
            <th>
                <a asp-page="Index"
                   asp-route-SortColumn="YearOfConstruction"
                   asp-route-SortOrder="@Model.Toggle("YearOfConstruction")"
                   asp-route-FilterCriteria="@Model.FilterCriteria" class="text-decoration-none text-dark">
                    Year of construction @(Model.SortColumn == "YearOfConstruction" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (Boat b in Model.Boats)
        {
            <tr>
                <td>@b.Id</td>
                <td>@b.TheBoatType</td>
                <td>@b.Model</td>
                <td>@b.SailNumber</td>
                <td>@b.EngineInfo</td>
                <td>@b.Draft</td>
                <td>@b.Width</td>
                <td>@b.Length</td>
                <td>@b.YearOfConstruction</td>
                <td><a asp-page="EditBoat" asp-route-sailnumber="@b.SailNumber" class="btn btn-primary">Edit</a></td>
            </tr>
        }
    </tbody>
</table>




